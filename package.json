{
  "name": "hackathon-budgeto",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:api": "nest start api --watch",
    "dev:worker": "node dist/apps/worker/main.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:api": "nest build api",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "migration:run": "npm run build:api && typeorm migration:run -d dist/apps/api/database/data-source.js",
    "migration:revert": "npm run build:api && typeorm migration:revert -d dist/apps/api/database/data-source.js",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "start:api": "node dist/apps/api/main.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.app.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "test:watch": "vitest --config apps/web/vitest.config.ts",
    "prepare": "lefthook install",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,css,html}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,css,html}\"",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@admiral-ds/react-ui": "^8.69.0",
    "@hookform/resolvers": "^3.9.1",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/cqrs": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.2",
    "bullmq": "^5.61.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "@tanstack/react-table": "^9.3.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "framer-motion": "^11.11.17",
    "i18next": "^23.16.8",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.0.7",
    "nuqs": "^2.10.2",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.1.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "styled-components": "^6.1.13",
    "typeorm": "^0.3.31",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/multer": "^1.4.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "lefthook": "^1.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
