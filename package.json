{
  "name": "hackathon-budgeto",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:api": "nest start api --watch",
    "build:api": "nest build api",
    "start:api": "node dist/apps/api/main.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.app.json",
    "prepare": "lefthook install",
    "lint": "eslint \"apps/**/*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx}\"",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/cqrs": "^10.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "lefthook": "^1.7.0",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0"
  }
}
