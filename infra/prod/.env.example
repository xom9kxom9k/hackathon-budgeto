POSTGRES_DB=budgetto
POSTGRES_USER=budgetto
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://budgetto:replace-with-a-long-random-password@postgres:5432/budgetto
REDIS_URL=redis://redis:6379
PORT=3000
WEB_ORIGIN=https://your-domain.example
CADDY_DOMAIN=your-domain.example
AUTH_ISSUER=Budgetto
AUTH_ENCRYPTION_KEY=replace-with-a-long-random-secret
SESSION_TTL_DAYS=7
IMPORT_STAGING_DIR=/app/.data/imports
NODE_ENV=production
