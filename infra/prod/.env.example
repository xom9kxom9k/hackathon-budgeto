POSTGRES_DB=budgeto
POSTGRES_USER=budgeto
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://budgeto:replace-with-a-long-random-password@postgres:5432/budgeto
REDIS_URL=redis://redis:6379
PORT=3000
WEB_ORIGIN=https://your-domain.example
CADDY_DOMAIN=your-domain.example
AUTH_ISSUER=Budgeto
AUTH_ENCRYPTION_KEY=replace-with-a-long-random-secret
SESSION_TTL_DAYS=7
IMPORT_STAGING_DIR=/app/.data/imports
NODE_ENV=production
